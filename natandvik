<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Natalie &amp; Victoria — Save the Date</title>
<style>
  :root{
    --blue: #7f97a6;
    --blue-dark: #5f7686;
    --blue-darker: #46596a;
    --cream: #f4efe6;
    --gold: #cbb27e;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color: transparent;}
  html,body{
    margin:0; padding:0;
    height:100%;
    overscroll-behavior:none;
    touch-action: manipulation;
  }
  body{
    background: radial-gradient(circle at 50% 18%, #eef1f2 0%, #dfe4e6 55%, #ccd3d6 100%);
    font-family: 'Georgia', 'Times New Roman', serif;
    display:flex; align-items:center; justify-content:center;
    overflow:hidden;
    min-height:100dvh;
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }
  .stage{
    position:relative;
    width:100%;
    height:100dvh;
    display:flex; flex-direction:column; align-items:center; justify-content:flex-end;
    padding-bottom: max(4vh, env(safe-area-inset-bottom));
    perspective: 1600px;
  }
  .hint{
    position:absolute;
    top:14%;
    left:50%; transform:translateX(-50%);
    color:#5f7686;
    letter-spacing:0.2em;
    font-size:clamp(10px, 3vw, 13px);
    text-transform:uppercase;
    opacity:0.75;
    transition:opacity .5s ease;
    pointer-events:none;
    white-space:nowrap;
  }
  .stage.opened .hint{opacity:0;}

  /* --- fluid scale: everything below is sized in em, and this font-size
         controls the whole envelope's real size across phone widths --- */
  .envelope-wrap{
    position:relative;
    font-size: clamp(13px, 4.6vw, 19px);
    width:20em; height:13.53em;
    cursor:pointer;
    -webkit-user-select:none; user-select:none;
    touch-action: manipulation;
  }
  .stage.opened .envelope-wrap{ cursor:default; }

  /* subtle idle breathing to invite a tap */
  .envelope-wrap:not(.opened) .flap{
    animation: wiggle 3.2s ease-in-out infinite;
  }
  @keyframes wiggle{
    0%,100%{ transform: rotateX(0deg); }
    6%{ transform: rotateX(-6deg); }
    12%{ transform: rotateX(0deg); }
  }

  .env-back{
    position:absolute;
    left:0; top:0; width:100%; height:100%;
    background: linear-gradient(160deg, var(--blue) 0%, var(--blue-dark) 100%);
    border-radius:0.25em;
    box-shadow: 0 1.8em 3.5em -1.2em rgba(30,45,55,0.45), 0 0.5em 1.1em rgba(30,45,55,0.25);
  }

  /* keeps the card fully hidden inside the envelope's bounds until it opens */
  .pocket{
    position:absolute;
    left:0; top:0; width:100%; height:100%;
    overflow:hidden;
    z-index:2;
    border-radius:0.25em;
  }
  .stage.opened .pocket{
    overflow:visible;
  }

  .card{
    position:absolute;
    left:50%; bottom:0.35em;
    width: min(330px, 78vw, calc(44vh / 1.406));
    transform-origin: center bottom;
    transform: translate(-50%, 0.4em) scale(0.36);
    opacity:0.98;
    border-radius:0.18em;
    overflow:hidden;
    box-shadow: 0 0.35em 1.4em rgba(20,30,38,0.35);
    transition: transform 1.05s cubic-bezier(.22,.9,.28,1.02) 0.55s,
                box-shadow 1.05s ease 0.55s;
  }
  .card img{
    display:block;
    width:100%;
    height:auto;
  }

  /* front pocket (bottom trapezoid) sits above the card's lower edge to hide it */
  .env-front{
    position:absolute;
    left:0; top:0; width:100%; height:100%;
    background: linear-gradient(160deg, var(--blue-dark) 0%, var(--blue-darker) 100%);
    clip-path: polygon(0% 32%, 50% 60%, 100% 32%, 100% 100%, 0% 100%);
    z-index:3;
  }

  .flap{
    position:absolute;
    left:0; top:0; width:100%; height:100%;
    background: linear-gradient(200deg, var(--blue) 0%, var(--blue-dark) 100%);
    clip-path: polygon(0% 0%, 100% 0%, 100% 32%, 50% 60%, 0% 32%);
    transform-origin: top center;
    transform-style: preserve-3d;
    transition: transform 0.85s cubic-bezier(.5,-0.2,.4,1.3);
    z-index:4;
  }
  .stage.opened .flap{
    transform: rotateX(178deg);
    z-index:1;
  }

  .seal{
    position:absolute;
    left:50%; top:3.41em;
    width:3.06em; height:3.06em;
    transform: translate(-50%,-50%);
    border-radius:50%;
    background: radial-gradient(circle at 32% 28%, #ddc794, var(--gold) 55%, #a98d54 100%);
    box-shadow: 0 0.18em 0.5em rgba(0,0,0,0.35), inset 0 0.06em 0.12em rgba(255,255,255,0.5);
    display:flex; align-items:center; justify-content:center;
    font-family: 'Snell Roundhand','Brush Script MT', cursive;
    color:#5a4826;
    font-size:1em;
    z-index:5;
    transition: transform 0.5s ease 0.05s, opacity 0.5s ease 0.05s;
  }
  .stage.opened .seal{
    transform: translate(-50%,-50%) scale(0.4) rotate(35deg);
    opacity:0;
  }

  .stage.opened .card{
    transform: translate(-50%, -15vh) scale(1);
  }

  .replay{
    margin-top:1.6em;
    padding:0.6em 1.4em;
    border-radius:999px;
    border:1px solid #5f7686;
    background:transparent;
    color:#46596a;
    font-family:inherit;
    font-size:clamp(11px, 3.4vw, 14px);
    letter-spacing:0.12em;
    text-transform:uppercase;
    cursor:pointer;
    opacity:0;
    transition:opacity .6s ease 1.4s;
    pointer-events:none;
    -webkit-appearance:none;
  }
  .stage.opened .replay{
    opacity:0.85;
    pointer-events:auto;
  }
  .replay:active{ background:#46596a; color:#f4efe6; }
  @media (hover:hover){
    .replay:hover{ background:#46596a; color:#f4efe6; }
  }

  @media (orientation: landscape) and (max-height: 480px){
    .envelope-wrap{ font-size: clamp(11px, 6.5vh, 15px); }
    .hint{ top:6%; }
    .replay{ margin-top:0.9em; }
  }
</style>
</head>
<body>

<div class="stage" id="stage">
  <div class="hint">Tap the envelope</div>
  <div class="envelope-wrap" id="envelope">
    <div class="env-back"></div>
    <div class="pocket">
      <div class="card"><img src="data:image/png;base64," alt="Save the Date"></div>
    </div>
    <div class="env-front"></div>
    <div class="flap"><div class="seal">N&amp;V</div></div>
  </div>
  <button class="replay" id="replayBtn">Open again</button>
</div>

<script>
  const stage = document.getElementById('stage');
  const envelope = document.getElementById('envelope');
  const replayBtn = document.getElementById('replayBtn');

  function openEnvelope(){
    stage.classList.add('opened');
  }
  function resetEnvelope(){
    stage.classList.remove('opened');
  }

  envelope.addEventListener('click', () => {
    if(!stage.classList.contains('opened')){
      openEnvelope();
    }
  });

  replayBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    resetEnvelope();
    setTimeout(openEnvelope, 500);
  });
</script>

</body>
</html>